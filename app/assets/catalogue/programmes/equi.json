 "materiel": {
  "fr": "Chaise, élastique",
  "en": "Chair, band"
 },
 "avertissement": {
  "fr": "Demande l'avis de ton médecin avant de commencer si tu as un problème de cœur, de tension, des vertiges ou une chute récente. Fais les exercices d'équilibre près d'un appui.",
  "en": "Ask your doctor before starting if you have heart or blood-pressure problems, dizziness or a recent fall. Do the balance exercises near something to hold."
 },
 "progression": null,
 "chargesDepart": false,
 "principes": {
  "fr": "L'exercice d'équilibre et de force des jambes, deux fois par semaine ou plus, réduit les chutes d'environ un quart. Avec la marche, 3 heures d'activité par semaine sont visées.",
  "en": "Balance and leg-strength exercise, twice a week or more, cuts falls by about a quarter. With walking, the aim is 3 hours of activity a week."
 },
