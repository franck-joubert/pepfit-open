 "resume": {
  "fr": "Pour reprendre en douceur après une pause, semaine après semaine.",
  "en": "To ease back in after a break, week by week."
 },
 "description": {
  "fr": "Après une pause : de l'isométrie et de l'équilibre, un renfo qui monte, puis le retour à la course en marche-course. Tu restes à l'aise, la difficulté vient avec les semaines.",
  "en": "After a break: isometrics and balance, strength that builds up, then a return to running with run-walk. You stay comfortable; the challenge comes with the weeks."
 },
